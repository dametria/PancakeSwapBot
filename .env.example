/**
 * Central environment configuration.
 *
 * ⚠️  SECURITY WARNING ⚠️
 * VITE_ variables are embedded into the client-side bundle at build time
 * and are VISIBLE to anyone who inspects the deployed site's source code.
 *
 * For production, upgrade to a Builder+ plan and move BOT_PRIVATE_KEY to a
 * server-side backend function where it's read via Deno.env.get().
 */

export const BOT_PRIVATE_KEY = import.meta.env.VITE_BOT_PRIVATE_KEY || "";

export const ARB_CONTRACT_ADDRESS = import.meta.env.VITE_ARB_CONTRACT_ADDRESS || "";

export const BSC_RPC_URL = import.meta.env.VITE_BSC_RPC_URL || "https://bsc-dataseed1.binance.org";
